{
  "name": "rust-analyzer-container",
  "version": "1.0.0",
  "private": false,
  "description": "Deterministic, offline, syntax-first rust-analyzer LSP package for pb.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "release": "semantic-release",
    "manifest:label": "node scripts/manifest-label.mjs",
    "config-schema:label": "node scripts/config-schema-label.mjs",
    "labels:check": "node -e \"const {execFileSync}=require('node:child_process'); for (const name of ['manifest:label','config-schema:label']) JSON.parse(execFileSync('npm',['run','--silent',name],{encoding:'utf8'}));\"",
    "package:check": "python3 scripts/validate-package.py && npm run labels:check"
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "semantic-release": "25.0.9"
  },
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "packageManager": "npm@10.9.2"
}
